# Modèle des variables d'environnement — AUCUNE valeur réelle ici.
# Ce fichier est versionné ; `.env` et `.env.*` ne le sont pas.
#
# En local : copier vers `.env.local`, puis lancer `npx vercel dev`
#            (`npm run dev` ne sert pas le dossier api/).
# En ligne : Vercel > Settings > Environment Variables,
#            puis redéployer — les variables ne s'appliquent
#            qu'aux nouveaux déploiements.

# --- Requis ---------------------------------------------------------

# Clé API Resend (https://resend.com > API Keys). Permission "Sending access".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Adresse de réception des messages du formulaire.
# Sans domaine vérifié chez Resend, cette adresse DOIT être celle
# du compte Resend, sinon les envois sont rejetés.
CONTACT_TO=ton-adresse@exemple.com

# Limitation de débit — base Upstash Redis.
# Si la base est rattachée via le Marketplace Vercel, ces variables sont
# injectées automatiquement (sous ce nommage ou en KV_REST_API_*, les deux
# sont acceptés). Sinon : Upstash > ta base > onglet REST API.
# ABSENTES = aucune limite appliquée, avec une erreur dans les logs Vercel.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxx

# --- Optionnels -----------------------------------------------------

# Expéditeur affiché. Nécessite un domaine vérifié chez Resend.
# Par défaut : "CV Web <onboarding@resend.dev>"
# CONTACT_FROM=CV Web <contact@tondomaine.com>

# Origines supplémentaires autorisées à appeler /api/contact,
# séparées par des virgules. L'origine du site lui-même est
# toujours acceptée automatiquement — à ne renseigner que si le
# formulaire est appelé depuis un autre domaine.
# ALLOWED_ORIGINS=https://tondomaine.com,https://www.tondomaine.com

# Mettre à 1 pour exposer le serveur de dev Vite sur le réseau local
# (test depuis un téléphone). Laisser vide sinon.
# EXPOSE_LAN=1
